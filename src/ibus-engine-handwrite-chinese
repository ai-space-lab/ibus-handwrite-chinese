class OnnxHandle:
    """PP-OCRv6 ONNX-based handwriting recognition backend."""

    def __init__(self, model_path, dict_path, max_candidates=None):
        if not HAS_NUMPY:
            raise RuntimeError("numpy is required for ONNX recognition")
        if max_candidates is None:
            max_candidates = CONFIG["engine"]["max_candidates"]
        import onnxruntime
        self.session = onnxruntime.InferenceSession(
            model_path, providers=["CPUExecutionProvider"]
        )
        self.dict = []
        with open(dict_path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.rstrip('\n')
                if line:
                    self.dict.append(line)
        # blank(0) + N chars + unknown(N+1)
        self.num_classes = len(self.dict) + 2
        self.max_candidates = max_candidates
        self.all_points = []
        self._last_results = []
        self._infer_lock = threading.Lock()
        self._log_session_id = str(uuid.uuid4())[:8]
        self.scale = 1  # HiDPI scale factor, set by HandwriteWin on activation

    def _log(self, data):
        try:
            entry = {"session_id": self._log_session_id, "t": time.time(), **data}
            with open(CONFIG["general"]["log_path"], "a") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
                f.flush()
        except Exception:  # Intentionally silent — logging must never crash the caller; recursive logging is impossible here
            pass

    def clear(self):
        self.all_points = []
        self._last_results = []

    def add_stroke(self, points):
        self.all_points.append(points)

    def _resize_bilinear(self, img, target_h):
        """Resize image to target_h height preserving aspect ratio."""
        h, w = img.shape
        scale = target_h / h
        target_w = max(int(w * scale), 1)
        src_y = np.arange(target_h, dtype=np.float32) * h / target_h
        src_x = np.arange(target_w, dtype=np.float32) * w / target_w
        y0 = np.floor(src_y).astype(np.int32)
        y1 = np.minimum(y0 + 1, h - 1)
        dy = src_y - y0
        x0 = np.floor(src_x).astype(np.int32)
        x1 = np.minimum(x0 + 1, w - 1)
        dx = src_x - x0
        return (
            img[y0[:, None], x0[None, :]] * (1 - dy[:, None]) * (1 - dx[None, :])
            + img[y1[:, None], x0[None, :]] * dy[:, None] * (1 - dx[None, :])
            + img[y0[:, None], x1[None, :]] * (1 - dy[:, None]) * dx[None, :]
            + img[y1[:, None], x1[None, :]] * dy[:, None] * dx[None, :]
        )

    def _preprocess(self):
        """Render strokes to numpy array and preprocess for ONNX inference."""
        if not self.all_points or not HAS_NUMPY:
            return None
        import cairo

        flat = [pt for stroke in self.all_points for pt in stroke]
        if not flat:
            return None
        xs = [p[0] for p in flat]
        ys = [p[1] for p in flat]
        xmin, xmax = min(xs), max(xs)
        ymin, ymax = min(ys), max(ys)
        # Canvas with padding, minimum 200px
        pad = 20
        cw = max(xmax - xmin + 2 * pad, 200)
        ch = max(ymax - ymin + 2 * pad, 200)
        width = int(cw)
        height = int(ch)
        # Render to ARGB32 offscreen surface
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, width, height)
        cr = cairo.Context(surface)
        # White background
        cr.set_source_rgb(1, 1, 1)
        cr.paint()
        # Draw black strokes
        cr.set_source_rgb(0, 0, 0)
        cr.set_line_width(CONFIG["engine"]["stroke_width"] * self.scale)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        for stroke in self.all_points:
            if len(stroke) < 2:
                continue
            cr.move_to(
                stroke[0][0] - xmin + pad, stroke[0][1] - ymin + pad
            )
            for pt in stroke[1:]:
                cr.line_to(pt[0] - xmin + pad, pt[1] - ymin + pad)
            cr.stroke()
        # Extract R channel (ARGB32 little-endian: B,G,R,A)
        buf = surface.get_data()
        arr = np.frombuffer(buf, dtype=np.uint8).reshape(height, width, 4)
        gray = arr[:, :, 2].astype(np.float32)  # R channel
        # Resize to 48px height preserving aspect ratio
        resized = self._resize_bilinear(gray, 48)  # [48, W]
        # Normalize to [-1, 1]: pixel / 127.5 - 1.0
        normalized = resized / 127.5 - 1.0
        # Add batch & channel dims -> [1, 3, 48, W]
        normalized = normalized[np.newaxis, np.newaxis, :, :]  # [1, 1, 48, W]
        normalized = np.repeat(normalized, 3, axis=1)  # [1, 3, 48, W]
        try:
            self._log({
                "event": "preprocess",
                "num_strokes": len(self.all_points),
                "num_points": sum(len(s) for s in self.all_points),
                "canvas_size": [width, height],
                "resized_width": resized.shape[1],
                "img_min": round(float(normalized.min()), 4),
                "img_max": round(float(normalized.max()), 4),
                "img_mean": round(float(normalized.mean()), 4),
            })
        except Exception:  # Intentionally silent — best-effort logging for preprocess metrics
            pass
        return np.ascontiguousarray(normalized, dtype=np.float32)

    def _decode(self, output):
        """CTC decode via aggregation: average softmax across time, exclude blank."""
        probs = output[0]  # [T, num_classes]
        avg_probs = np.max(probs, axis=0)  # [num_classes] — max over time steps (CTC peak confidence)
        # Exclude blank (index 0) and unknown (last index)
        char_probs = avg_probs[1:-1]
        k = min(self.max_candidates, len(char_probs))
        top_indices = np.argpartition(char_probs, -k)[-k:]
        top_indices = top_indices[np.argsort(char_probs[top_indices])[::-1]]
        try:
            top5 = [(self.dict[idx], round(float(char_probs[idx]), 4)) for idx in top_indices[:5]]
            self._log({
                "event": "decode",
                "top5": top5,
                "num_classes": self.num_classes,
                "time_steps": int(output.shape[1]),
            })
        except Exception:  # Intentionally silent — best-effort logging for decode metrics
            pass
        return [(self.dict[idx], float(char_probs[idx])) for idx in top_indices]

    def classify(self):
        """Run inference synchronously, return [(char, score), ...]."""
        if not self.all_points or not HAS_NUMPY:
            return []
        t0 = time.time()
        input_tensor = self._preprocess()
        if input_tensor is None:
            self._log({"event": "classify", "latency_ms": 0, "input_shape": None})
            return []
        input_shape = list(input_tensor.shape)
        output = self.session.run(None, {"x": input_tensor})[0]
        result = self._decode(output)
        self._log({"event": "classify", "latency_ms": round((time.time() - t0) * 1000, 2), "input_shape": input_shape})
        return result

    def get_results(self):
        """Non-blocking get last results."""
        return list(self._last_results)

    def classify_async(self, callback):
        """Run inference in background thread, call callback via GLib.idle_add."""
        if not self._infer_lock.acquire(blocking=False):
            return  # inference already in progress

        def _run():
            try:
                results = self.classify()
                self._last_results = results
                GLib.idle_add(callback, results)
            finally:
                self._infer_lock.release()

        t = threading.Thread(target=_run, daemon=True)
        t.start()

    def destroy(self):
        self.all_points = []
        self._last_results = []


class HandwriteWin(Gtk.Window):

    @staticmethod
    def _write_log(msg):
        import os
        with open('/tmp/hw.log', 'a') as f:
            f.write(str(os.getpid()) + ' ' + msg + '\n')


    def __init__(self, engine):
        Gtk.Window.__init__(self, type=Gtk.WindowType.TOPLEVEL)
        self.engine = engine

        # Detect HiDPI scale factor from GDK_SCALE env var or GTK monitor
        self._scale = 1
        gdk_scale = os.environ.get('GDK_SCALE')
        if gdk_scale is not None:
            try:
                parsed = int(gdk_scale)
                if 1 <= parsed <= 4:
                    self._scale = parsed
            except (ValueError, TypeError):
                pass
        screen = Gdk.Screen.get_default()
        if screen:
            display = screen.get_display()
            if display:
                primary = display.get_primary_monitor()
                if primary:
                    self._scale = max(self._scale, max(1, min(primary.get_scale_factor(), 4)))
        # Propagate scale to ONNX preprocessor (for stroke line width)
        if hasattr(self.engine.recognizer, 'scale'):
            self.engine.recognizer.scale = self._scale

        win_w = CONFIG["window"]["width"] * self._scale
        win_h = CONFIG["window"]["height"] * self._scale
        self.set_title("Chinese Handwriting")
        self.set_default_size(win_w, win_h)
        self.set_size_request(win_w, win_h)
        self.set_resizable(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_accept_focus(False)
        self.set_decorated(False)
        self.set_border_width(0)

        self._theme = CONFIG["general"]["theme"]
        self._css_provider = Gtk.CssProvider()
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(
            screen, self._css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self._apply_theme(self._theme)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(vbox)

        self.close_btn = Gtk.Button(label="×")
        self.close_btn.get_style_context().add_class("close-btn")
        self.close_btn.set_can_focus(False)
        self.close_btn.connect("clicked", self.on_close_click)
        self.drag_handle = Gtk.EventBox()
        self.drag_handle.set_size_request(-1, CONFIG["window"]["drag_handle_height"] * self._scale)
        self.drag_handle.set_app_paintable(True)
        self.drag_handle.connect("draw", self.on_draw_handle)
        self.drag_handle.add_events(Gdk.EventMask.BUTTON_PRESS_MASK |
                                    Gdk.EventMask.BUTTON_RELEASE_MASK |
                                    Gdk.EventMask.POINTER_MOTION_MASK |
                                    Gdk.EventMask.ENTER_NOTIFY_MASK |
                                    Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.drag_handle.connect("button-press-event", self.on_drag_begin)
        self.drag_handle.connect("button-release-event", self.on_drag_end)
        self.drag_handle.connect("motion-notify-event", self.on_drag_move)
        self.drag_handle.connect("enter-notify-event", self.on_drag_enter)
        self.drag_handle.connect("leave-notify-event", self.on_drag_leave)
        top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        top_bar.pack_start(self.close_btn, False, False, 0)
        top_bar.pack_start(self.drag_handle, True, True, 0)
        vbox.pack_start(top_bar, False, False, 0)

        self.cand_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        self.cand_bar.set_margin_top(4)
        self.cand_bar.set_margin_bottom(2)
        self.cand_bar.set_margin_start(6)
        self.cand_bar.set_margin_end(4)

        self.cand_inner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=1)
        self.cand_bar.pack_start(self.cand_inner, True, True, 0)

        self.delete_btn = Gtk.Button(label="⌫")
        self.delete_btn.get_style_context().add_class("delete-btn")
        self.delete_btn.set_can_focus(False)
        self.delete_btn.connect("clicked", self.on_delete_tap)
        self.delete_btn.connect("button-press-event", self.on_delete_press)
        self.delete_btn.connect("button-release-event", self.on_delete_release)
        self.cand_bar.pack_end(self.delete_btn, False, False, 0)

        vbox.pack_start(self.cand_bar, False, False, 0)

        self.darea = Gtk.DrawingArea()
        self.darea.set_size_request(
            CONFIG["window"]["width"] * self._scale,
            CONFIG["window"]["drawing_height"] * self._scale,
        )
        self.darea.add_events(Gdk.EventMask.BUTTON_PRESS_MASK |
                              Gdk.EventMask.BUTTON_RELEASE_MASK |
                              Gdk.EventMask.POINTER_MOTION_MASK)
        self.darea.connect("draw", self.on_draw)
        self.darea.connect("button-press-event", self.on_btn_down)
        self.darea.connect("button-release-event", self.on_btn_up)
        self.darea.connect("motion-notify-event", self.on_move)
        vbox.pack_start(self.darea, True, True, 0)

        self.pix = None
        self.cur_stroke = []
        self.strokes = []
        self.drawing = False
        self._drag_x = 0
        self._drag_y = 0
        self.candidate_buttons = []
        self._last_redraw = 0.0
        self._last_esc_time = 0.0
        self._min_redraw_ms = CONFIG["engine"]["min_redraw_ms"]
        self._state = 0
        self._blank_cursor = Gdk.Cursor.new(Gdk.CursorType.BLANK_CURSOR)
        self._cursor_hidden = False
        self._trackpad = None
        self._cand_page = 0
        self._page_size = CONFIG["engine"]["page_size"]
        self._delete_timer = None
        self._delete_held = False
        self._drag_hovered = False
        self._momentum_pages = 0
        self._momentum_velocity = 0.0
        self._momentum_source = None
        self._momentum_dir = 1
        self._highlighted_idx = -1
        self._pending_pause_timeout = None

        self.connect("key-press-event", self.on_key)
        self.connect("button-press-event", self.on_window_click)
        self.connect("focus-out-event", self.on_focus_out_event)
        self.connect("focus-in-event", self.on_focus_in_event)

    def _apply_theme(self, theme_name):
        """Apply (or switch) theme CSS and update Cairo drawing colors."""
        css_data = handwrite_config.get_theme_css(theme_name, scale=self._scale)
        self._css_provider.load_from_data(css_data)
        self._theme = theme_name
        self._theme_colors = self._compute_theme_colors(theme_name)

    @staticmethod
    def _compute_theme_colors(theme):
        """Return a dict of Cairo color tuples for the given theme name."""
        if theme == "light":
            return {
                "drawing_bg": (0.96, 0.96, 0.96),
                "stroke": (0.05, 0.05, 0.05),
                "pause_overlay": (1, 1, 1, 0.5),
                "pause_box": (0.85, 0.85, 0.85, 0.6),
                "pause_text": (0.1, 0.1, 0.1),
                "pause_shadow": (1, 1, 1),
                "handle_bg": (0.85, 0.85, 0.85),
                "handle_dots": (0.4, 0.4, 0.4),
                "handle_dots_hover": (0.2, 0.2, 0.2),
            }
        # Dark theme (default)
        return {
            "drawing_bg": (0.15, 0.15, 0.17),
            "stroke": (1, 1, 1),
            "pause_overlay": (0, 0, 0, 0.5),
            "pause_box": (0, 0, 0, 0.6),
            "pause_text": (1, 1, 1),
            "pause_shadow": (0, 0, 0),
            "handle_bg": (0.2, 0.2, 0.2),
            "handle_dots": (0.5, 0.5, 0.5),
            "handle_dots_hover": (0.8, 0.8, 0.8),
        }

    def start_trackpad(self):
        if not EVDEV_AVAILABLE:
            print("  [engine] handwrite_evdev module not available", file=sys.stderr)
            return False
        self._trackpad = handwrite_evdev.TrackpadReader({
            'on_stroke_begin': self.on_trackpad_begin,
            'on_stroke_point': self.on_trackpad_point,
            'on_stroke_end': self.on_trackpad_end,
            'on_tap': self.on_trackpad_tap,
            'on_swipe_left': self.on_trackpad_swipe_left,
            'on_swipe_right': self.on_trackpad_swipe_right,
            'on_candidate_highlight': self.on_trackpad_candidate_highlight,
            'on_candidate_select': self.on_trackpad_candidate_select,
        })
        ok = self._trackpad.start()
        if not ok:
            print("  [engine] Trackpad initialization failed", file=sys.stderr)
        return ok

    def stop_trackpad(self):
        self._cancel_momentum()
        if self._trackpad:
            self._trackpad.stop()
            self._trackpad = None

    def on_key_esc(self):
        now = time.time()
        if now - self._last_esc_time < 0.15:
            return
        self._last_esc_time = now
        self._write_log('on_key_esc: _state=%d' % self._state)
        if self._state == 0:
            self._state = 1
            self.stop_trackpad()
            self._restore_cursor()
            self.darea.queue_draw()
            self.queue_draw()
            self.show_candidates([])
            self.close_btn.show()
        else:
            self._do_reset()
            self._do_disable()
            self.engine.restore_previous_engine()

    def on_close_click(self, btn=None):
        self._do_reset()
        self._do_disable()
        self.engine.restore_previous_engine()

    def on_key(self, w, ev):
        name = Gdk.keyval_name(ev.get_keyval()[1])
        if name == "Escape":
            self.on_key_esc()
            return True
        if name == "Return" and self.engine.last_results:
            self.engine.commit_first()
            return True
        if name == "BackSpace":
            self.on_delete_tap(None)
            return True
        return False

    def on_window_click(self, widget, ev):
        if self._state == 1:
            self._state = 0
            self.darea.queue_draw()
            self.start_trackpad()
            self.engine.update_candidates()
            self.present()
        return False

    def on_focus_out_event(self, widget, event):
        """Auto-pause with debounce when window loses keyboard focus."""
        self._write_log('on_focus_out_event: focus lost, scheduling auto-pause timer')
        if self._state != 0 or not self.get_visible():
            return False
        if getattr(self.engine, '_disabling', False):
            return False
        # Cancel any pending auto-pause (prevent timer stacking)
        if self._pending_pause_timeout:
            GLib.source_remove(self._pending_pause_timeout)
        # Schedule auto-pause with configurable debounce
        self._pending_pause_timeout = GLib.timeout_add(
            CONFIG["engine"]["auto_pause_debounce_ms"], self._handle_focus_lost)
        return False

    def on_focus_in_event(self, widget, event):
        """Cancel pending auto-pause when window regains keyboard focus."""
        self._write_log('on_focus_in_event: focus regained')
        if self._pending_pause_timeout:
            self._write_log('on_focus_in_event: cancelling pending pause timer')
            GLib.source_remove(self._pending_pause_timeout)
            self._pending_pause_timeout = None
        return False

    def _handle_focus_lost(self):
        """Actual auto-pause after debounce."""
        self._pending_pause_timeout = None
        if self._state != 0 or not self.get_visible():
            return False
        if getattr(self.engine, '_disabling', False):
            return False
        self.engine._write_log('_handle_focus_lost: auto-pausing after focus loss')
        self.on_key_esc()
        return False

    def _set_cursor_hidden(self, hidden):
        gw = self.get_window()
        if not gw or self._cursor_hidden == hidden:
            return
        gw.set_cursor(self._blank_cursor if hidden else None)
        self._cursor_hidden = hidden

    def _hide_cursor(self):
        self._set_cursor_hidden(True)

    def _restore_cursor(self):
        self._set_cursor_hidden(False)

    def _do_reset(self):
        self.strokes = []
        self.cur_stroke = []
        self.pix = None
        self.queue_draw()
        self.show_candidates([])
        self.engine.recognizer.clear()
        self.engine.last_results = []

    def _do_disable(self):
        if self._pending_pause_timeout:
            GLib.source_remove(self._pending_pause_timeout)
            self._pending_pause_timeout = None
        self.stop_trackpad()
        self._restore_cursor()
        self.hide()
        self._state = 0

    def _do_clear_strokes(self):
        self.strokes.clear()
        self.engine.recognizer.clear()
        self.pix = None
        self.queue_draw()
        self.engine.update_candidates()

    def _do_forward_backspace(self):
        try:
            self.engine.delete_surrounding_text(-1, 1)
        except Exception as e:  # Broad catch — IBus delete_surrounding_text may fail (no active context, bus error)
            self._write_log(f"ERROR: delete_surrounding_text failed: {e}")

    def on_delete_tap(self, btn=None):
        if self._delete_held:
            self._delete_held = False
            return
        has_strokes = bool(self.strokes) or bool(self.cur_stroke)
        self._do_clear_strokes()
        if not has_strokes:
            self._do_forward_backspace()

    def on_delete_press(self, btn, ev):
        self._delete_held = False
        if self._delete_timer:
            GLib.source_remove(self._delete_timer)
        self._delete_timer = GLib.timeout_add(CONFIG["engine"]["delete_hold_ms"], self._on_delete_hold_timeout)
        return False

    def _on_delete_hold_timeout(self):
        self._delete_held = True
        self._do_clear_strokes()
        self._do_forward_backspace()
        return False

    def on_delete_release(self, btn, ev):
        if self._delete_timer:
            GLib.source_remove(self._delete_timer)
            self._delete_timer = None

    def show_candidates(self, results):
        self._highlighted_idx = -1
        for btn in self.candidate_buttons:
            btn.destroy()
        self.candidate_buttons = []
        if not results:
            self._cand_page = 0
            return
        total = len(results)
        max_page = (total - 1) // self._page_size
        if self._cand_page > max_page:
            self._cand_page = max_page
        start = self._cand_page * self._page_size
        end = start + self._page_size
        for i, (val, score) in enumerate(results[start:end]):
            actual_idx = start + i
            btn = Gtk.Button(label=val)
            btn.get_style_context().add_class("candidate-btn")
            btn.set_can_focus(False)
            btn.set_size_request(CONFIG["window"]["candidate_button_width"] * self._scale, -1)
            btn.connect("clicked", lambda b, idx=actual_idx: self.engine.pick_candidate(idx))
            self.cand_inner.pack_start(btn, False, False, 0)
            self.candidate_buttons.append(btn)
        self.cand_inner.show_all()

    def _pixel_coords(self, frac_x, frac_y):
        alloc = self.darea.get_allocation()
        return (frac_x * alloc.width, frac_y * alloc.height)

    def _throttle_redraw(self):
        t = time.time() * 1000
        if t - self._last_redraw >= self._min_redraw_ms:
            self.queue_draw()
            self._last_redraw = t

    def on_trackpad_begin(self, frac_x, frac_y):
        px, py = self._pixel_coords(frac_x, frac_y)
        self.drawing = True
        self.cur_stroke = [(px, py)]

    def on_trackpad_point(self, frac_x, frac_y):
        if not self.drawing:
            return
        px, py = self._pixel_coords(frac_x, frac_y)
        self.cur_stroke.append((px, py))
        if len(self.cur_stroke) > 1:
            self._hide_cursor()
        self._throttle_redraw()

    def on_trackpad_end(self, points_frac):
        self._restore_cursor()
        if not points_frac:
            self.drawing = False
            return
        alloc = self.darea.get_allocation()
        pixel_pts = [(fx * alloc.width, fy * alloc.height) for fx, fy in points_frac]
        self.drawing = False
        self.strokes.append(pixel_pts)
        self.engine.recognizer.add_stroke(pixel_pts)
        self.engine._has_drawn = True
        self.cur_stroke = []
        self.pix = None
        self.queue_draw()
        self.engine.update_candidates()

    def on_trackpad_tap(self, x_frac):
        self._restore_cursor()
        delete_at = 0.82
        if x_frac > delete_at:
            self.on_delete_tap(None)
            return
        num = len(self.engine.last_results)
        if num > 0:
            start = self._cand_page * self._page_size
            visible = min(self._page_size, num - start)
            if visible > 0:
                scaled = x_frac / delete_at
                idx = min(start + int(scaled * visible), num - 1)
                self.engine.pick_candidate(idx)

    def _cancel_momentum(self):
        if self._momentum_source is not None:
            GLib.source_remove(self._momentum_source)
            self._momentum_source = None

    def _momentum_tick(self):
        if self._momentum_pages <= 0:
            self._momentum_source = None
            return False
        total = len(self.engine.last_results)
        if total > 0:
            max_page = (total - 1) // self._page_size
            if self._momentum_dir > 0:
                self._cand_page = min(self._cand_page + 1, max_page)
            else:
                self._cand_page = max(self._cand_page - 1, 0)
            self.show_candidates(self.engine.last_results)
        self._momentum_pages -= 1
        self._momentum_velocity *= CONFIG["engine"]["momentum_decay"]
        if self._momentum_velocity < CONFIG["engine"]["momentum_threshold"]:
            self._momentum_source = None
            return False
        self._momentum_pages = max(1, int(self._momentum_velocity))
        return True

    def on_trackpad_swipe_left(self, pages=1):
        total = len(self.engine.last_results)
        if total > 0:
            max_page = (total - 1) // self._page_size
            self._cand_page = min(self._cand_page + 1, max_page)
            self.show_candidates(self.engine.last_results)
            if pages > 1:
                self._momentum_dir = 1
                self._momentum_pages = pages - 1
                self._momentum_velocity = float(pages) * CONFIG["engine"]["momentum_decay"]
                self._cancel_momentum()
                self._momentum_source = GLib.timeout_add(
                    CONFIG["engine"]["momentum_tick_ms"], self._momentum_tick)

    def on_trackpad_swipe_right(self, pages=1):
        total = len(self.engine.last_results)
        if total > 0:
            self._cand_page = max(self._cand_page - 1, 0)
            self.show_candidates(self.engine.last_results)
            if pages > 1:
                self._momentum_dir = -1
                self._momentum_pages = pages - 1
                self._momentum_velocity = float(pages) * CONFIG["engine"]["momentum_decay"]
                self._cancel_momentum()
                self._momentum_source = GLib.timeout_add(
                    CONFIG["engine"]["momentum_tick_ms"], self._momentum_tick)

    def on_trackpad_candidate_highlight(self, x_frac):
        delete_at = 0.82
        if x_frac > delete_at:
            if self._highlighted_idx >= 0:
                old = self.candidate_buttons[self._highlighted_idx]
                old.get_style_context().remove_class("candidate-btn-highlighted")
                self._highlighted_idx = -1
            return
        num = len(self.engine.last_results)
        if num == 0:
            return
        start = self._cand_page * self._page_size
        visible = min(self._page_size, num - start)
        if visible <= 0:
            return
        scaled = x_frac / delete_at
        local_idx = min(int(scaled * visible), visible - 1)
        if local_idx == self._highlighted_idx:
            return
        if self._highlighted_idx >= 0 and self._highlighted_idx < len(self.candidate_buttons):
            old_btn = self.candidate_buttons[self._highlighted_idx]
            old_btn.get_style_context().remove_class("candidate-btn-highlighted")
        if local_idx < len(self.candidate_buttons):
            new_btn = self.candidate_buttons[local_idx]
            new_btn.get_style_context().add_class("candidate-btn-highlighted")
            self._highlighted_idx = local_idx

    def on_trackpad_candidate_select(self, x_frac):
        delete_at = 0.82
        if x_frac > delete_at:
            self.on_delete_tap(None)
            return
        num = len(self.engine.last_results)
        if num > 0:
            start = self._cand_page * self._page_size
            visible = min(self._page_size, num - start)
            if visible > 0:
                scaled = x_frac / delete_at
                idx = min(start + int(scaled * visible), num - 1)
                self.engine.pick_candidate(idx)
        if self._highlighted_idx >= 0 and self._highlighted_idx < len(self.candidate_buttons):
            self.candidate_buttons[self._highlighted_idx].get_style_context().remove_class("candidate-btn-highlighted")
            self._highlighted_idx = -1

    def rebuild_pix(self, ww, hh):
        import cairo
        self.pix = cairo.ImageSurface(cairo.FORMAT_ARGB32, ww, hh)
        cr = cairo.Context(self.pix)
        bg = self._theme_colors["drawing_bg"]
        cr.set_source_rgb(*bg)
        cr.paint()
        stroke = self._theme_colors["stroke"]
        cr.set_source_rgb(*stroke)
        cr.set_line_width(3 * self._scale)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        cr.set_antialias(cairo.ANTIALIAS_BEST)
        for stroke in self.strokes:
            if len(stroke) < 2:
                continue
            cr.move_to(stroke[0][0], stroke[0][1])
            for pt in stroke[1:]:
                cr.line_to(pt[0], pt[1])
            cr.stroke()

    def on_btn_down(self, w, ev):
        self.drawing = True
        self.cur_stroke = [(ev.x, ev.y)]

    def on_move(self, w, ev):
        if self.drawing and (ev.state & Gdk.ModifierType.BUTTON1_MASK):
            self.cur_stroke.append((ev.x, ev.y))
            self._throttle_redraw()

    def on_btn_up(self, w, ev):
        if not self.drawing:
            return
        self.drawing = False
        if self.cur_stroke:
            self.cur_stroke.append((ev.x, ev.y))
            self.strokes.append(self.cur_stroke)
            self.engine.recognizer.add_stroke(self.cur_stroke)
            self.engine._has_drawn = True
            self.cur_stroke = []
            self.pix = None
        self.queue_draw()
        self.engine.update_candidates()

    def on_draw(self, w, cr):
        import cairo
        alloc = self.darea.get_allocation()
        ww, hh = alloc.width, alloc.height
        if self._state == 1:
            overlay = self._theme_colors["pause_overlay"]
            cr.set_source_rgba(*overlay)
            cr.rectangle(0, 0, ww, hh)
            cr.fill()
            text_color = self._theme_colors["pause_text"]
            cr.set_source_rgb(*text_color)
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(30 * self._scale)
            text = "click to resume"
            xb = cr.text_extents(text)
            box_w, box_h = xb.width + 40, xb.height + 30
            cr.rectangle((ww - box_w) / 2, (hh - box_h) / 2, box_w, box_h)
            box = self._theme_colors["pause_box"]
            cr.set_source_rgba(*box)
            cr.fill()
            # Shadow for visibility
            shadow = self._theme_colors["pause_shadow"]
            cr.set_source_rgb(*shadow)
            cr.move_to((ww - xb.width) / 2 + 2, (hh - xb.height) / 2 + 22)
            cr.show_text(text)
            cr.set_source_rgb(*text_color)
            cr.move_to((ww - xb.width) / 2, (hh - xb.height) / 2 + 20)
            cr.show_text(text)
            return
        if self.pix is None:
            self.rebuild_pix(ww, hh)
        cr.set_source_surface(self.pix, 0, 0)
        cr.paint()
        if self.cur_stroke and len(self.cur_stroke) > 1:
            stroke_color = self._theme_colors["stroke"]
            cr.set_source_rgb(*stroke_color)
            cr.set_line_width(3 * self._scale)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_line_join(cairo.LINE_JOIN_ROUND)
            cr.set_antialias(cairo.ANTIALIAS_BEST)
            cr.move_to(self.cur_stroke[0][0], self.cur_stroke[0][1])
            for pt in self.cur_stroke[1:]:
                cr.line_to(pt[0], pt[1])
            cr.stroke()

    def on_draw_handle(self, widget, cr):
        alloc = widget.get_allocation()
        handle_bg = self._theme_colors["handle_bg"]
        cr.set_source_rgb(*handle_bg)
        cr.rectangle(0, 0, alloc.width, alloc.height)
        cr.fill()
        toplevel = widget.get_toplevel()
        if toplevel:
            win_w = toplevel.get_allocation().width
            origin = widget.translate_coordinates(toplevel, 0, 0)
            if origin:
                cx = win_w / 2 - origin[0]
            else:
                cx = alloc.width / 2
        else:
            cx = alloc.width / 2
        if self._drag_hovered:
            dots_color = self._theme_colors["handle_dots_hover"]
            cr.set_source_rgb(*dots_color)
        else:
            dots_color = self._theme_colors["handle_dots"]
            cr.set_source_rgb(*dots_color)
        for i in range(5):
            x = cx + (i - 2) * 10
            cr.arc(x, alloc.height / 2, 2, 0, 6.2832)
            cr.fill()

    def on_drag_enter(self, widget, ev):
        self._drag_hovered = True
        self.drag_handle.queue_draw()
        return False

    def on_drag_leave(self, widget, ev):
        self._drag_hovered = False
        self.drag_handle.queue_draw()
        return False

    def on_drag_begin(self, widget, ev):
        self._drag_x = ev.x_root
        self._drag_y = ev.y_root
        return True

    def on_drag_end(self, widget, ev):
        pass

    def on_drag_move(self, widget, ev):
        if ev.state & Gdk.ModifierType.BUTTON1_MASK:
            dx = int(ev.x_root - self._drag_x)
            dy = int(ev.y_root - self._drag_y)
            if dx or dy:
                px, py = self.get_position()
                self.move(px + dx, py + dy)
                self._drag_x = ev.x_root
                self._drag_y = ev.y_root

    def destroy(self):
        if self._pending_pause_timeout:
            GLib.source_remove(self._pending_pause_timeout)
            self._pending_pause_timeout = None
        self.stop_trackpad()
        self._restore_cursor()
        if self._delete_timer:
            GLib.source_remove(self._delete_timer)
            self._delete_timer = None
        self.pix = None
        Gtk.Window.destroy(self)


class HandwriteEngine(IBus.Engine if HAS_IBUS else object):
    def __init__(self):
        super().__init__()
        self.onnx = self._create_onnx_handle()
        self.win = None
        self.last_results = []
        self._bus = None
        self._watch_id = None
        self._cx = 0
        self._cy = 0
        self._cw = 0
        self._ch = 0
        self._engine_name = None
        self._last_focus_out_time = 0.0
        self._last_enable_time = 0.0
        self._has_drawn = False
        self._focused_since_enable = False
        self._disabling = False
        session_type = os.environ.get("XDG_SESSION_TYPE", "unknown")
        self._write_log(f"Session type: {session_type}")

    @property
    def recognizer(self):
        """Return the ONNX recognizer backend."""
        return self.onnx

    @staticmethod
    def _create_onnx_handle():
        """Resolve PP-OCR model paths and create OnnxHandle.

        Priority:
          1. Config model.path / dict.path (from IBUS_HANDWRITE_PPOCR_MODEL_PATH / DICT_PATH env vars)
          2. Default candidate paths (data/ dir, system install dir, /tmp/)
        """
        cfg_model = CONFIG["model"]
        tier = cfg_model["tier"]
        base = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

        # Check explicit paths from config/env first
        model_override = cfg_model["path"]
        dict_override = cfg_model["dict_path"]
        if model_override and dict_override:
            if os.path.exists(model_override) and os.path.exists(dict_override):
                return OnnxHandle(model_override, dict_override, CONFIG["engine"]["max_candidates"])
            print(f"  [engine] Warning: IBUS_HANDWRITE_PPOCR_MODEL_PATH={model_override} or "
                  f"IBUS_HANDWRITE_PPOCR_DICT_PATH={dict_override} not found, falling back to defaults",
                  file=sys.stderr)

        # Default candidate-based resolution
        candidates = [
            os.path.join(base, 'data', 'models', f'ppocrv6_{tier}_rec.onnx'),
            f'/usr/local/share/ibus-handwrite-chinese/models/ppocrv6_{tier}_rec.onnx',
            f'/tmp/models/ppocrv6_{tier}.onnx',
        ]
        dict_candidates = [
            os.path.join(base, 'data', 'models', f'dict_v6.txt'),
            f'/usr/local/share/ibus-handwrite-chinese/models/dict_v6.txt',
            '/tmp/models/dict_v6.txt',
        ]
        model_path = None
        dict_path = None
        for mp, dp in zip(candidates, dict_candidates):
            if os.path.exists(mp):
                model_path = mp
                dict_path = dp
                break
        if not model_path or not os.path.exists(model_path):
            raise FileNotFoundError(
                f"PP-OCR model not found for tier '{tier}'. "
                f"Tried: {candidates}"
            )
        if not os.path.exists(dict_path):
            raise FileNotFoundError(
                f"PP-OCR dict not found for tier '{tier}'. "
                f"Tried: {dict_candidates}"
            )
        return OnnxHandle(model_path, dict_path, CONFIG["engine"]["max_candidates"])

    def do_process_key_event(self, keyval, keycode, state):
        self._write_log('do_pke: keyval=%d state=%d visible=%s' % (keyval, state, str(self.win.get_visible() if self.win else False)))
        # Always handle ESC regardless of RELEASE_MASK (Firefox sends ESC with release mask)
        if keyval in (IBus.KEY_Escape,) and self.win and self.win.get_visible():
            self.win.on_key_esc()
            return True
        if state & IBus.ModifierType.RELEASE_MASK:
            return super(HandwriteEngine, self).do_process_key_event(keyval, keycode, state)
        # Only intercept Backspace/Enter when actively writing (state 0)
        if keyval in (IBus.KEY_BackSpace, IBus.KEY_Return) and self.win and self.win.get_visible() and self.win._state == 0:
            if keyval == IBus.KEY_BackSpace:
                self.win._do_clear_strokes()
                return False
            elif keyval == IBus.KEY_Return and self.last_results:
                self.commit_first()
                return True
        return super(HandwriteEngine, self).do_process_key_event(keyval, keycode, state)

    def do_set_cursor_location(self, x, y, w, h):
        self._cx = x
        self._cy = y
        self._cw = w
        self._ch = h
        if self.win and self.win.get_visible() and (x > 0 or y > 0):
            self._position_window()

    def _position_window(self):
        if not self.win:
            return
        screen = Gdk.Screen.get_default()
        display = screen.get_display()
        win_w = CONFIG["window"]["width"] * self.win._scale
        win_h = self.win.get_allocated_height() or (CONFIG["window"]["height"] * self.win._scale)
        our_gdk_win = self.win.get_window()
        active = screen.get_active_window()
        if active is None:
            # No active window (Wayland or desktop focused). Position near cursor if available.
            if self._cx > 0 or self._cy > 0:
                mon = display.get_primary_monitor()
                wa = mon.get_workarea()
                wx = min(self._cx, wa.x + wa.width - win_w - 12)
                wy = min(self._cy + 30, wa.y + wa.height - win_h - 12)
                wx = max(wx, wa.x)
                wy = max(wy, wa.y)
                self.win.move(int(wx), int(wy))
                return
            # First-show fallback: center of primary monitor (no cursor event yet)
            mon = display.get_primary_monitor()
            wa = mon.get_workarea()
            wx = wa.x + (wa.width - win_w) // 2
            wy = wa.y + (wa.height - win_h) // 2
            self.win.move(int(wx), int(wy))
            return
        if active == our_gdk_win:
            # User clicked on our window — keep current position
            return
        rect = active.get_frame_extents()
        mon = display.get_monitor_at_window(active)
        wa = mon.get_workarea()
        candidates = [
            (rect.x + rect.width + 10, rect.y),
            (rect.x, rect.y + rect.height + 10),
            (rect.x - win_w - 10, rect.y),
            (rect.x, rect.y - win_h - 10),
            (wa.x + wa.width - win_w - 12, wa.y + wa.height - win_h - 12),
        ]
        for wx, wy in candidates:
            if (wa.x <= wx <= wa.x + wa.width - win_w and
                wa.y <= wy <= wa.y + wa.height - win_h):
                self.win.move(int(wx), int(wy))
                return

    def do_enable(self):
        self._last_enable_time = time.time()
        self._has_drawn = False
        self._write_log('do_enable: t=%.3f' % self._last_enable_time)
        if self.win is None:
            self.win = HandwriteWin(self)
        if self._bus is None:
            self._bus = IBus.Bus()
        self.win._state = 0

        current = self._bus.get_global_engine()
        if current:
            self._engine_name = current.get_name()
        self.recognizer.clear()
        self.last_results = []
        self._focused_since_enable = False
        self.win.set_accept_focus(True)
        self.win.show_all()
        self._position_window()
        # Use idle_add so the X11 property changes from show_all() and
        # set_accept_focus(True) are flushed to the X server before
        # present() asks the window manager for keyboard focus.
        GLib.idle_add(self._grab_focus_if_needed, priority=GLib.PRIORITY_LOW)
        if not self.win.start_trackpad():
            print("  [engine] ⚠ Trackpad not available. Use mouse or check tools/diagnose_trackpad.sh", file=sys.stderr)
        if self._watch_id is None:
            self._watch_id = GLib.timeout_add(500, self._check_engine)

    def _grab_focus_if_needed(self):
        """One-shot: always grab keyboard focus so ESC and auto-pause work.

        Without present(), the window never has keyboard focus and GTK
        on_focus_out_event never fires — breaking auto-pause on Firefox
        and desktop clicks. present() is safe because the user is in
        handwriting mode and interacts via trackpad/mouse, not keyboard.
        """
        if not self.win or not self.win.get_visible():
            self._write_log('_grab_focus_if_needed: window not visible, skipping')
            return False
        self.win.set_accept_focus(True)
        self.win.present()
        if self._focused_since_enable:
            self._write_log('_grab_focus_if_needed: text field was focused, focus grabbed for window')
        else:
            self._write_log('_grab_focus_if_needed: grabbing keyboard focus')
        self._write_log('_grab_focus_if_needed: done')
        return False

    def do_disable(self):
        self._disabling = True
        # Clean up pending auto-pause timer on the window
        if self.win and self.win._pending_pause_timeout:
            GLib.source_remove(self.win._pending_pause_timeout)
            self.win._pending_pause_timeout = None
        if self._watch_id:
            GLib.source_remove(self._watch_id)
            self._watch_id = None
        if self.win:
            self.win._restore_cursor()
            self.win.stop_trackpad()
        if self.win:
            self.win.set_accept_focus(False)
            self.win.hide()
        self._disabling = False
        self.recognizer.clear()
        self.last_results = []

    def restore_previous_engine(self):
        if not self._bus:
            return
        try:
            settings = Gio.Settings.new('org.freedesktop.ibus.general')
            engines = settings.get_strv('preload-engines')
            for name in engines:
                if name and name != self._engine_name:
                    self._bus.set_global_engine(name)
                    return
        except Exception as e:  # Broad catch — Gio.Settings or IBus may fail (schema unavailable, bus disconnected)
            self._write_log(f"ERROR: restore_engine (Gio.Settings) failed: {e}")
        try:
            self._bus.set_global_engine('xkb:us::eng')
        except Exception as e:  # Broad catch — ibus set_global_engine fallback may fail (bus disconnected)
            self._write_log(f"ERROR: restore_engine (fallback xkb:us::eng) failed: {e}")

    def _write_log(self, msg):
        import os
        with open('/tmp/hw.log', 'a') as _f:
            _f.write(str(os.getpid()) + ' ' + msg + '\n')

    def do_focus_out(self):
        """Auto-pause when IBus input context loses focus (e.g., clicking Firefox title bar)."""
        self._focused_since_enable = False
        elapsed = time.time() - self._last_enable_time
        self._write_log('do_focus_out: elapsed=%.3f last_enable_time=%.3f' % (elapsed, self._last_enable_time))
        if elapsed < 1.0:
            self._write_log('do_focus_out: startup guard caught it, returning')
            return
        if not self._has_drawn:
            self._write_log('do_focus_out: no strokes drawn yet, skipping auto-pause')
            return
        if self.win and self.win.get_visible() and self.win._state == 0:
            self._last_focus_out_time = time.time()
            self._write_log('do_focus_out: window visible, state=0 -> auto-pause')
            self.win.on_key_esc()

    def do_focus_in(self):
        """Auto-resume when IBus input context regains focus (e.g., clicking back into input field)."""
        self._focused_since_enable = True
        self._last_focus_in_time = time.time()
        self._write_log('do_focus_in: text field got focus (_state=%s _has_drawn=%s)' % (
            str(self.win._state) if self.win else 'None',
            str(self._has_drawn)
        ))
        # Cancel pending auto-pause timer if user was actively drawing
        # (real text field switch, not spurious desktop click).
        # The _has_drawn guard distinguishes: with strokes drawn the user is
        # switching between typing sessions; without strokes it's likely a
        # spurious focus-in from XFCE desktop click.
        if self._has_drawn and self.win and self.win._pending_pause_timeout:
            GLib.source_remove(self.win._pending_pause_timeout)
            self.win._pending_pause_timeout = None
            self._write_log('do_focus_in: cancelled auto-pause timer (strokes drawn, real focus)')
        if self.win and self.win.get_visible() and self.win._state == 1 and (time.time() - self._last_focus_out_time) >= 0.3:
            self._write_log('do_focus_in: window visible, state=1 -> auto-resume (debounce gate passed)')
            self.win._state = 0
            self.win.darea.queue_draw()
            if not self.win.start_trackpad():
                print("  [engine] ⚠ Trackpad re-grab failed after focus-in. Mouse fallback active.", file=sys.stderr)
            self.update_candidates()

    def _check_engine(self):
        if self._bus and self.win:
            current = self._bus.get_global_engine()
            if current and current.get_name() != self._engine_name:
                if self.win.get_visible():
                    self.win._do_disable()
                self._watch_id = None
                return False
        return True

    def do_reset(self):
        if self.win:
            self.win._do_reset()
        self.recognizer.clear()
        self.last_results = []

    def _on_results(self, results):
        self.last_results = results
        if self.win:
            self.win.show_candidates(results)

    def update_candidates(self):
        self.onnx.classify_async(self._on_results)

    def commit_first(self):
        if self.last_results:
            self.commit_text(IBus.Text.new_from_string(self.last_results[0][0]))
            self.do_reset()

    def pick_candidate(self, idx):
        if idx < len(self.last_results):
            self.commit_text(IBus.Text.new_from_string(self.last_results[idx][0]))
            self.do_reset()

    def destroy(self):
        if self.win:
            self.win.destroy()
            self.win = None
        if self.onnx:
            self.onnx.destroy()
            self.onnx = None
        super().destroy()


if HAS_IBUS:
    GObject.type_register(HandwriteEngine)


class TestCommitEngine:
    """Minimal engine for --test mode: no IBus dependency."""
    def __init__(self):
        self.onnx = HandwriteEngine._create_onnx_handle()
        self.last_results = []
        self.committed = []
        self.win = None

    @property
    def recognizer(self):
        """Return the ONNX recognizer backend."""
        return self.onnx

    def commit_text(self, text):
        self.committed.append(text)
        print(f"COMMIT:{text}", flush=True)

    def delete_surrounding_text(self, offset, n_chars):
        # No-op in --test mode (no IBus context to forward BackSpace to)
        pass

    def _write_log(self, msg):
        # Delegate to HandwriteWin's static _write_log so _handle_focus_lost
        # (called via self.engine._write_log) doesn't crash in --test mode.
        HandwriteWin._write_log(msg)

    def do_reset(self):
        if self.win:
            self.win._do_reset()
        self.recognizer.clear()
        self.last_results = []

    def commit_first(self):
        if self.last_results:
            self.commit_text(self.last_results[0][0])
            self.do_reset()

    def pick_candidate(self, idx):
        if idx < len(self.last_results):
            self.commit_text(self.last_results[idx][0])
            self.do_reset()

    def update_candidates(self):
        results = self.onnx.classify()
        self.last_results = results
        if self.win:
            self.win.show_candidates(results)

    def restore_previous_engine(self):
        if self.win:
            self.win._do_reset()
            self.win._do_disable()

    def destroy(self):
        if self.onnx:
            self.onnx.destroy()
            self.onnx = None


def main():
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument('--ibus', action='store_true')
    parser.add_argument('--test', action='store_true')
    args = parser.parse_args()

    engine_name = "handwrite-chinese"
    engine_longname = "Chinese Handwriting"
    engine_language = "zh"
    component_name = "com.github.ai-space-lab.ibus-handwrite-chinese"

    Gtk.init(sys.argv)

    if args.test:
        engine = TestCommitEngine()
        win = HandwriteWin(engine)
        engine.win = win
        win.show_all()
        win.set_accept_focus(True)
        win.present()
        if not win.start_trackpad():
            print("  [engine] ⚠ Trackpad not available. Use mouse to draw.", file=sys.stderr)
        Gtk.main()
        return

    IBus.init()

    bus = IBus.Bus()
    factory = IBus.Factory.new(bus.get_connection())
    factory.add_engine(engine_name, HandwriteEngine.__gtype__)

    component = IBus.Component.new(
        component_name,
        "Chinese Handwriting Input Method",
        _ENGINE_VERSION,
        "GPLv3",
        "ai-space-lab",
        "",
        "",
        "ibus-engine-handwrite-chinese"
    )
    engine_desc = IBus.EngineDesc.new(
        engine_name,
        engine_longname,
        "Chinese handwriting input using touchpad",
        engine_language,
        "GPLv3",
        "ai-space-lab",
        "",
        "us"
    )
    component.add_engine(engine_desc)

    if args.ibus:
        bus.request_name(component_name, 0)
    else:
        bus.register_component(component)

    IBus.main()


if __name__ == "__main__":
    main()
